        : '三源协同：《MSBA 秋季课表》 + 《Canvas 任务日历》 + 《个人日常规范》';
      document.getElementById('rules-btn-text').textContent = currentLang === 'en' ? 'System Rules' : '调度规则说明';
      document.getElementById('evening-btn-text').textContent = currentLang === 'en' ? '22:30 Evening Check-in' : '22:30 晚间复盘/插单';
      document.getElementById('scenario-eyebrow').textContent = currentLang === 'en'
        ? 'Interactive Demo Scenarios (Select a Day)'
        : '交互式典型日程场景切换（点击查看不同日期排程）';
      document.getElementById('scenario-desc').textContent = currentLang === 'en'
        ? 'Switch between representative days from your November 2026 calendar to inspect how AI schedules classes, commutes, workouts, and buffers.'
        : '切换 2026 年 11 月典型日程，直观展示 AI 如何联动课表、DDL、通勤缓冲及紧急插单重排机制。';
      document.getElementById('reset-day-btn').textContent = currentLang === 'en' ? 'Reset Day State' : '重置本日状态';
      document.getElementById('dispatch-badge').textContent = currentLang === 'en' ? '07:20 Morning Dispatch' : '07:20 早间日程播报';
      document.getElementById('metrics-title').textContent = currentLang === 'en' ? 'Daily Time Budget (07:30 – 23:30)' : '每日时间账本 (07:30 – 23:30)';
      document.getElementById('metric-study-lbl').textContent = currentLang === 'en' ? 'Tier S/A/B Focus' : 'S/A/B 核心学习';
      document.getElementById('metric-commute-lbl').textContent = currentLang === 'en' ? 'Meals & Commute' : '餐饮与通勤锁';
      document.getElementById('metric-buffer-lbl').textContent = currentLang === 'en' ? 'Wkly Buffer Left' : '本周剩余缓冲池';
      document.getElementById('skipped-label').textContent = currentLang === 'en' ? 'Auto-Deferred:' : '动态降级/顺延：';
      document.getElementById('timeline-heading').textContent = currentLang === 'en'
        ? 'Time-Blocked Daily Execution Plan (07:30 – 23:30)'
        : '全天时间块执行清单（07:30 – 23:30）';
      document.getElementById('timeline-sub').textContent = currentLang === 'en'
        ? 'Click checkboxes to mark blocks complete. Sleep (23:30–07:30) is strictly locked.'
        : '点击左侧勾选框标记完成状态。核心睡眠窗口（23:30–07:30）系统绝对锁定。';
      document.getElementById('sleep-lock-badge').textContent = currentLang === 'en'
        ? 'Sleep Locked: 23:30 – 07:30 (8.0h)'
        : '睡眠锁定：23:30 – 07:30 (8.0h)';

      // Day Header & Metrics
      const statusPill = document.getElementById('load-status-pill');
      statusPill.textContent = currentLang === 'en' ? day.loadStatusEn : day.loadStatusZh;
      statusPill.className = `text-xs font-semibold px-2.5 py-1 rounded-full ${day.loadBadgeClass}`;

      document.getElementById('day-headline').textContent = currentLang === 'en' ? day.headlineEn : day.headlineZh;
      document.getElementById('day-alert-text').textContent = currentLang === 'en' ? day.alertEn : day.alertZh;
      document.getElementById('metric-study-hrs').textContent = `${day.studyHrs}h`;
      document.getElementById('metric-commute-hrs').textContent = `${day.commuteMealHrs}h`;
      document.getElementById('metric-buffer-hrs').textContent = `${day.bufferHrs}h`;
      document.getElementById('skipped-items-text').textContent = currentLang === 'en' ? day.skippedEn : day.skippedZh;

      const doneCount = day.blocks.filter(b => b.done).length;
      document.getElementById('completion-counter').textContent = currentLang === 'en'
        ? `${doneCount} / ${day.blocks.length} Done`
        : `已完成 ${doneCount} / ${day.blocks.length}`;

      // Rebalance Log Box
      const logBox = document.getElementById('rebalance-log-box');
      const logList = document.getElementById('rebalance-log-list');
      if (day.rebalanceLogs.length > 0) {
        logBox.classList.remove('hidden');
        document.getElementById('rebalance-log-title').textContent = currentLang === 'en'
          ? 'Dynamic Re-Balance Engine Executed:'
          : 'AI 动态重排引擎已执行调整：';
        logList.innerHTML = day.rebalanceLogs
          .map(item => `<li>${currentLang === 'en' ? item.en : item.zh}</li>`)
          .join('');
      } else {
        logBox.classList.add('hidden');
      }

      // Render Timeline Blocks
      const container = document.getElementById('timeline-container');
      container.innerHTML = '';

      day.blocks.forEach((block, idx) => {
        const style = getTierStyle(block.tier);
        const card = document.createElement('div');
        card.className = `relative z-10 flex items-start gap-3 p-3.5 rounded-xl border transition ${style.card} ${block.done ? 'opacity-65' : ''}`;

        card.innerHTML = `
          <div class="pt-0.5 shrink-0">
            <input type="checkbox" ${block.done ? 'checked' : ''}
              onchange="toggleBlockDone('${block.id}')"
              class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold font-mono text-slate-800 bg-white px-2 py-0.5 rounded border border-slate-200 shadow-2xs">
                  ${block.time}
                </span>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded ${style.badge}">
                  ${block.code}
                </span>
              </div>
              <span class="text-[11px] font-medium text-slate-500">
                ${currentLang === 'en' ? style.labelEn : style.labelZh}
              </span>
            </div>

            <div class="mt-1.5 text-sm font-semibold text-slate-900 ${block.done ? 'line-through text-slate-500' : ''}">
              ${currentLang === 'en' ? block.titleEn : block.titleZh}
            </div>

            <div class="mt-1 text-xs text-slate-500 flex items-center gap-1.5">
              <span>↳</span>
              <span>${currentLang === 'en' ? block.noteEn : block.noteZh}</span>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // Toggle Task Completion
    function toggleBlockDone(blockId) {
      const day = schedulesState[currentDayId];
      const target = day.blocks.find(b => b.id === blockId);
      if (target) {
        target.done = !target.done;
        renderAll();
      }
    }

    // Toggle Language
    function toggleLanguage() {
      currentLang = currentLang === 'en' ? 'zh' : 'en';
      renderAll();
    }

    // Reset Current Day
    function resetCurrentDay() {
      schedulesState[currentDayId] = JSON.parse(JSON.stringify(initialScenarios[currentDayId]));
      renderAll();
    }

    // Modal Controls
    function openEveningModal() {
      document.getElementById('evening-modal').classList.remove('hidden');
    }
    function closeEveningModal() {
      document.getElementById('evening-modal').classList.add('hidden');
    }
    function toggleRulesModal() {
      document.getElementById('rules-modal').classList.toggle('hidden');
    }

    // Preset Urgent Task Button
    function injectPresetUrgent() {
      applyUrgentRebalance(
        currentLang === 'en' ? 'Urgent MSBA Team Case Sync (2.0h)' : '突发 MSBA 小组紧急会议 (2.0h)',
        2.0,
        'S'
      );
    }

    // Form Submit Handler
    function handleUrgentSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('urgent-task-name').value.trim();
      const duration = parseFloat(document.getElementById('urgent-task-duration').value);
      const priority = document.getElementById('urgent-task-priority').value;
      if (!name) return;

      applyUrgentRebalance(name, duration, priority);
      document.getElementById('urgent-task-name').value = '';
      closeEveningModal();
    }

    // Dynamic Re-Balancing Engine (Graceful Degradation + Emergency Buffer Consumption)
    function applyUrgentRebalance(taskName, duration, priority) {
      const day = schedulesState[currentDayId];
      let remainingNeeded = duration;

      // Step 1: Check if current day has an Emergency Buffer block
      const bufferIdx = day.blocks.findIndex(b => b.tier === 'Buffer');
      if (bufferIdx !== -1 && remainingNeeded > 0) {
        const bufBlock = day.blocks[bufferIdx];
        const absorbed = Math.min(bufBlock.duration, remainingNeeded);
        remainingNeeded -= absorbed;
        day.bufferHrs = Math.max(0, +(day.bufferHrs - absorbed).toFixed(1));

        if (absorbed >= bufBlock.duration) {
          day.blocks.splice(bufferIdx, 1, {
            id: 'urg-' + Date.now(),
            time: bufBlock.time,
            duration: absorbed,
            tier: priority,
            code: `URGENT (${priority})`,
            titleEn: `[Added] ${taskName}`,
            titleZh: `[紧急插单] ${taskName}`,
            noteEn: `Absorbed by Emergency Buffer (${absorbed}h) — zero Tier A/B disruption`,
            noteZh: `由应急缓冲池吸收（${absorbed}h）— 未破坏任何核心学习计划`,
            done: false
          });
        } else {
          bufBlock.duration = +(bufBlock.duration - absorbed).toFixed(1);
          bufBlock.titleEn = `Remaining Emergency Buffer (${bufBlock.duration}h)`;
          bufBlock.titleZh = `剩余应急缓冲池 (${bufBlock.duration}h)`;
          day.blocks.splice(bufferIdx, 0, {
            id: 'urg-' + Date.now(),
            time: '19:30 – 20:30',
            duration: absorbed,
            tier: priority,
            code: `URGENT (${priority})`,
            titleEn: `[Added] ${taskName}`,
            titleZh: `[紧急插单] ${taskName}`,
            noteEn: `Consumed ${absorbed}h of Emergency Buffer`,
            noteZh: `消耗 ${absorbed}h 应急缓冲时间`,
            done: false
          });
        }

        day.rebalanceLogs.push({
          en: `Inserted "${taskName}" (${duration}h) into today's Emergency Buffer. Remaining weekly buffer: ${day.bufferHrs}h.`,
          zh: `已将紧急事项“${taskName}”（${duration}h）填入今日应急缓冲池，本周剩余缓冲池：${day.bufferHrs}h。`
        });
      }

      // Step 2: If buffer wasn't present or insufficient, apply Graceful Degradation (Cut Tier C first, then Tier B)
      if (remainingNeeded > 0) {
        const cutCandidates = ['C', 'B'];
        let preemptedNamesEn = [];
        let preemptedNamesZh = [];

        for (const targetTier of cutCandidates) {
          for (let i = day.blocks.length - 1; i >= 0 && remainingNeeded > 0; i--) {
            const blk = day.blocks[i];
            if (blk.tier === targetTier && blk.code !== 'C2_Podcast') {
              preemptedNamesEn.push(`${blk.code} (${blk.time})`);
              preemptedNamesZh.push(`${blk.code} (${blk.time})`);
              remainingNeeded -= blk.duration;

              day.blocks.splice(i, 1, {
                id: 'urg-' + Date.now() + i,
                time: blk.time,
                duration: blk.duration,
                tier: priority,
                code: `URGENT (${priority})`,
                titleEn: `[Urgent Override] ${taskName}`,
                titleZh: `[紧急插单替换] ${taskName}`,
                noteEn: `Preempted ${blk.code} via Graceful Degradation; 23:30 sleep lock preserved`,
                noteZh: `触发优先级降级替换原 ${blk.code}；死守 23:30 睡眠底线`,
                done: false
              });
            }
          }
        }

        if (preemptedNamesEn.length > 0) {
          day.skippedEn += ` | Preempted: ${preemptedNamesEn.join(', ')}`;
          day.skippedZh += ` | 紧急抢占：${preemptedNamesZh.join(', ')}`;
          day.rebalanceLogs.push({
            en: `No free buffer today. Applied Graceful Degradation: preempted ${preemptedNamesEn.join(', ')} to fit "${taskName}".`,
            zh: `今日无空闲缓冲池，已触发优先级降级规则：自动砍掉 ${preemptedNamesZh.join(', ')} 以承接“${taskName}”。`
          });
        } else {
          day.rebalanceLogs.push({
            en: `Day is at 100% Tier S capacity. Deferred "${taskName}" to Thursday's Thanksgiving catch-up window.`,
            zh: `当日已排满最高级 S 类学术任务，已自动将“${taskName}”顺延至周四感恩节追赶窗口。`
          });
        }
      }

      day.studyHrs = +(day.studyHrs + duration).toFixed(1);
      renderAll();
    }

    // Initialize
    renderAll();
  </script>
</body>
</html>

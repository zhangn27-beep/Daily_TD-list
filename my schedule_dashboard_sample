<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MSBA Dynamic Schedule & AI Dispatch Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', 'Noto Sans SC', sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }
    .timeline-line::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 1.15rem;
      width: 2px;
      background-color: #e2e8f0;
      z-index: 0;
    }
    @keyframes slideIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-slide-in {
      animation: slideIn 0.25s ease-out forwards;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Top Navigation & Bilingual Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-900 text-white flex items-center justify-center font-bold text-lg shadow-sm">
          UW
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 id="app-title" class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">
              MSBA AI Schedule & Dynamic To-Do System
            </h1>
            <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200">
              AUT 2026 • Gold/B
            </span>
          </div>
          <p id="app-subtitle" class="text-xs text-slate-500">
            Three-Source Sync: MSBA Class Schedule + Canvas DDLs + Routine Spec
          </p>
        </div>
      </div>

      <!-- Right Controls: Language Toggle, Rules Drawer, Evening Check-in Trigger -->
      <div class="flex items-center gap-2 sm:gap-3">
        <button onclick="toggleLanguage()" id="lang-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition flex items-center gap-1.5 shadow-xs">
          <span>🌐</span>
          <span id="lang-label">中文 / EN</span>
        </button>

        <button onclick="toggleRulesModal()"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition flex items-center gap-1.5 shadow-xs">
          <span>📐</span>
          <span id="rules-btn-text">System Rules</span>
        </button>

        <button onclick="openEveningModal()"
          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white transition flex items-center gap-1.5 shadow-sm">
          <span>🌙</span>
          <span id="evening-btn-text">22:30 Evening Check-in</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- Scenario Day Switcher Bar -->
    <section class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600" id="scenario-eyebrow">
            Interactive Demo Scenarios (Select a Day)
          </span>
          <h2 class="text-sm font-medium text-slate-600" id="scenario-desc">
            Switch between representative days from your November 2026 calendar to inspect how AI schedules classes, commutes, workouts, and buffers.
          </h2>
        </div>
        <button onclick="resetCurrentDay()" class="self-start sm:self-auto text-xs text-slate-500 hover:text-indigo-600 underline font-medium" id="reset-day-btn">
          Reset Day State
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5" id="day-selector-grid">
        <!-- Populated by JS -->
      </div>
    </section>

    <!-- Status Alert & Metrics Bar -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-4">
      <!-- Left: Morning Dispatch Status Banner -->
      <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-md">
              ☀️ <span id="dispatch-badge">07:20 Morning Dispatch</span>
            </span>
            <span id="load-status-pill" class="text-xs font-semibold px-2.5 py-1 rounded-full">
              High-DDL Sprint
            </span>
          </div>
          <h3 id="day-headline" class="text-lg font-bold text-slate-900 mt-1">
            Tuesday, Nov 17, 2026 — Evening Lecture & Clustered DDLs
          </h3>
          <p id="day-alert-text" class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed">
            Key Alerts: TECHIN 599 (13:30) & BUS AN 513 Ex4 (17:59) due today. Dinner shifted to 16:30–17:35; depart for PCAR 291 at 17:35.
          </p>
        </div>

        <!-- Dynamic Rebalance Log (Visible when urgent task added) -->
        <div id="rebalance-log-box" class="hidden mt-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-900 space-y-1 animate-slide-in">
          <div class="font-bold flex items-center gap-1.5">
            <span>⚡</span>
            <span id="rebalance-log-title">Dynamic Re-Balance Engine Executed:</span>
          </div>
          <ul id="rebalance-log-list" class="list-disc list-inside space-y-0.5 text-rose-800"></ul>
        </div>
      </div>

      <!-- Right: Daily Hours & Buffer Accounting -->
      <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500" id="metrics-title">
            Daily Time Budget (07:30 – 23:30)
          </span>
          <span id="completion-counter" class="text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-0.5 rounded-full">
            0 / 12 Done
          </span>
        </div>

        <div class="grid grid-cols-3 gap-2.5 text-center">
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div id="metric-study-hrs" class="text-lg font-bold text-slate-900">6.5h</div>
            <div id="metric-study-lbl" class="text-[11px] font-medium text-slate-500 mt-0.5">Tier S/A/B Focus</div>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div id="metric-commute-hrs" class="text-lg font-bold text-slate-900">2.75h</div>
            <div id="metric-commute-lbl" class="text-[11px] font-medium text-slate-500 mt-0.5">Meals & Commute</div>
          </div>
          <div class="p-2.5 rounded-xl bg-emerald-50/70 border border-emerald-200">
            <div id="metric-buffer-hrs" class="text-lg font-bold text-emerald-700">4.5h</div>
            <div id="metric-buffer-lbl" class="text-[11px] font-medium text-emerald-700 mt-0.5">Wkly Buffer Left</div>
          </div>
        </div>

        <div class="mt-3 pt-3 border-t border-slate-100 flex items-start gap-2 text-xs text-slate-600">
          <span class="font-semibold text-slate-700 shrink-0" id="skipped-label">Auto-Deferred:</span>
          <span id="skipped-items-text" class="text-slate-500">C3_Gym (1x/wk), B1_Case Study (shifted to Thu/Sun)</span>
        </div>
      </div>
    </section>

    <!-- Main Two-Column Content: Left Timeline, Right Priority Legend & Quick Actions -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- Left Column (8 cols): Interactive Time-Blocked To-Do Timeline -->
      <div class="lg:col-span-8 bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2 bg-slate-50/60">
          <div>
            <h3 class="text-sm font-bold text-slate-900" id="timeline-heading">
              Time-Blocked Daily Execution Plan (07:30 – 23:30)
            </h3>
            <p class="text-xs text-slate-500" id="timeline-sub">
              Click checkboxes to mark blocks complete. Sleep (23:30–07:30) is strictly locked.
            </p>
          </div>
          <div class="flex items-center gap-1.5 text-[11px] font-medium text-slate-500">
            <span class="w-2.5 h-2.5 rounded-full bg-slate-800 inline-block"></span>
            <span id="sleep-lock-badge">Sleep Locked: 23:30 – 07:30 (8.0h)</span>
          </div>
        </div>

        <div class="p-4 sm:p-5 relative timeline-line space-y-3" id="timeline-container">
          <!-- Timeline blocks injected here -->
        </div>
      </div>

      <!-- Right Column (4 cols): Priority Matrix & Live Urgent Task Simulator -->
      <div class="lg:col-span-4 space-y-5">

        <!-- Priority Tier Legend Card -->
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3" id="legend-title">
            Priority & Degradation Hierarchy
          </h4>
          <div class="space-y-2.5 text-xs">
            <div class="flex items-start gap-2.5 p-2 rounded-lg bg-rose-50/70 border border-rose-200/80">
              <span class="px-1.5 py-0.5 rounded font-bold bg-rose-600 text-white shrink-0">S</span>
              <div>
                <div class="font-semibold text-slate-900" id="tier-s-name">Academic Core & DDLs</div>
                <div class="text-slate-600 text-[11px]" id="tier-s-desc">MSBA lectures & Canvas deadlines. Never preempted.</div>
              </div>
            </div>

            <div class="flex items-start gap-2.5 p-2 rounded-lg bg-indigo-50/70 border border-indigo-200/80">
              <span class="px-1.5 py-0.5 rounded font-bold bg-indigo-600 text-white shrink-0">A</span>
              <div>
                <div class="font-semibold text-slate-900" id="tier-a-name">Core Skills (A1 > A2 > A3)</div>
                <div class="text-slate-600 text-[11px]" id="tier-a-desc">Bereal Research, SQL (7h/wk), Duolingo (15m/day).</div>
              </div>
            </div>

            <div class="flex items-start gap-2.5 p-2 rounded-lg bg-amber-50/70 border border-amber-200/80">
              <span class="px-1.5 py-0.5 rounded font-bold bg-amber-600 text-white shrink-0">B</span>
              <div>
                <div class="font-semibold text-slate-900" id="tier-b-name">Cases & Climbing (B1 > B2)</div>
                <div class="text-slate-600 text-[11px]" id="tier-b-desc">Case Study (8h/wk), Bouldering (3x/wk + 1.5h commute).</div>
              </div>
            </div>

            <div class="flex items-start gap-2.5 p-2 rounded-lg bg-slate-100 border border-slate-200">
              <span class="px-1.5 py-0.5 rounded font-bold bg-slate-600 text-white shrink-0">C</span>
              <div>
                <div class="font-semibold text-slate-900" id="tier-c-name">Flexible (C1 > C2 > C3 > C4)</div>
                <div class="text-slate-600 text-[11px]" id="tier-c-desc">Reading, Podcast, Gym (1x/wk + 40m commute), Power BI (Dec 1). Cut first under overload.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Urgent Task Injector Card (Inline Preview of Evening Check-in) -->
        <div class="bg-gradient-to-br from-slate-900 to-indigo-950 text-white rounded-2xl p-5 shadow-md">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-300" id="sim-eyebrow">
              Live AI Re-Balance Demo
            </span>
            <span class="text-xs bg-white/10 px-2 py-0.5 rounded text-indigo-200">22:30 Mode</span>
          </div>
          <h4 class="text-base font-bold" id="sim-title">
            Got an Unexpected Urgent Task?
          </h4>
          <p class="text-xs text-slate-300 mt-1 leading-relaxed" id="sim-desc">
            Test how the AI protects your sleep (23:30) and classes by consuming Emergency Buffers first, then automatically cutting Tier C/B tasks.
          </p>

          <div class="mt-4 space-y-2.5">
            <button onclick="injectPresetUrgent()"
              class="w-full py-2.5 px-3 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white text-xs font-semibold transition flex items-center justify-center gap-2 shadow-xs">
              <span>⚡</span>
              <span id="preset-urgent-btn">Simulate: +2.0h Urgent Team Meeting</span>
            </button>
            <button onclick="openEveningModal()"
              class="w-full py-2 px-3 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-medium transition border border-white/15">
              <span id="custom-urgent-btn">Open Full Evening Check-in Form...</span>
            </button>
          </div>
        </div>

      </div>
    </section>
  </main>

  <!-- Evening Check-in & Urgent Task Modal -->
  <div id="evening-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full border border-slate-200 shadow-2xl overflow-hidden animate-slide-in">
      <div class="px-6 py-4 bg-indigo-950 text-white flex items-center justify-between">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-300">Mode B • 22:30 Interactive Intake</span>
          <h3 class="text-base font-bold" id="modal-evening-title">Evening Check-in & Urgent Task Re-balancer</h3>
        </div>
        <button onclick="closeEveningModal()" class="text-slate-300 hover:text-white text-xl leading-none">&times;</button>
      </div>

      <form onsubmit="handleUrgentSubmit(event)" class="p-6 space-y-4 text-sm">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1" id="lbl-task-name">
            1. New Urgent / Extra Task Name
          </label>
          <input type="text" id="urgent-task-name" required
            placeholder="e.g., BUS AN 506 Emergency Team Sync / Professor Office Hours"
            class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1" id="lbl-task-duration">
              2. Estimated Duration
            </label>
            <select id="urgent-task-duration"
              class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="1">1.0 Hour</option>
              <option value="1.5">1.5 Hours</option>
              <option value="2" selected>2.0 Hours</option>
              <option value="2.5">2.5 Hours</option>
              <option value="3">3.0 Hours</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1" id="lbl-task-priority">
              3. Priority Tier
            </label>
            <select id="urgent-task-priority"
              class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="S">Tier S (Academic / Hard DDL)</option>
              <option value="A">Tier A (High Priority Project)</option>
              <option value="B">Tier B (Moderate Priority)</option>
            </select>
          </div>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 space-y-1">
          <div class="font-semibold text-slate-800" id="modal-rule-note-title">AI Re-balancing Logic:</div>
          <p id="modal-rule-note-body">
            The system will first check for available <strong>Emergency Buffer</strong> slots on the current day. If none exist, it will automatically preempt <strong>Tier C</strong> (Gym, Reading, Podcast) or <strong>Tier B</strong> (Case Study) blocks while preserving your 23:30 sleep lock and campus commute buffers.
          </p>
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-2">
          <button type="button" onclick="closeEveningModal()"
            class="px-4 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-50">
            Cancel
          </button>
          <button type="submit"
            class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm">
            Run AI Re-balance & Update Schedule
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- System Rules & Three-Source Architecture Modal -->
  <div id="rules-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full border border-slate-200 shadow-2xl overflow-hidden animate-slide-in max-h-[90vh] flex flex-col">
      <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between shrink-0">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-300">System Specification Reference</span>
          <h3 class="text-base font-bold">Three-Source Architecture & Hard Constraints</h3>
        </div>
        <button onclick="toggleRulesModal()" class="text-slate-300 hover:text-white text-xl leading-none">&times;</button>
      </div>

      <div class="p-6 overflow-y-auto space-y-4 text-xs text-slate-700 leading-relaxed">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="p-3 rounded-xl bg-indigo-50 border border-indigo-200">
            <div class="font-bold text-indigo-950 mb-1">1. MSBA Class Schedule</div>
            <p class="text-indigo-900/80">Tue & Thu 18:00–21:15 evening lectures; bi-weekly Sat 09:00–16:45 full-day ML classes. Locked as Tier S.</p>
          </div>
          <div class="p-3 rounded-xl bg-rose-50 border border-rose-200">
            <div class="font-bold text-rose-950 mb-1">2. Canvas Calendar</div>
            <p class="text-rose-900/80">Triggers Tier S Academic Sprint Blocks 2–3 days prior to clustered DDLs (e.g., TECHIN 599, BUS AN 506/513).</p>
          </div>
          <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200">
            <div class="font-bold text-emerald-950 mb-1">3. Routine Spec Doc</div>
            <p class="text-emerald-900/80">Governs 07:30–23:30 canvas, meal shifts, round-trip commutes, weekly task quotas, and C4 Power BI handoff on Dec 1.</p>
          </div>
        </div>

        <div class="border border-slate-200 rounded-xl overflow-hidden">
          <table class="w-full text-left border-collapse">
            <thead class="bg-slate-100 text-slate-800 font-bold">
              <tr>
                <th class="p-2.5 border-b border-slate-200">Constraint / Activity</th>
                <th class="p-2.5 border-b border-slate-200">Net Duration</th>
                <th class="p-2.5 border-b border-slate-200">Commute Buffer</th>
                <th class="p-2.5 border-b border-slate-200">Hard Rule</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <tr>
                <td class="p-2.5 font-semibold">Core Sleep Window</td>
                <td class="p-2.5">8.0 hrs</td>
                <td class="p-2.5">—</td>
                <td class="p-2.5">23:30 – 07:30 strictly locked</td>
              </tr>
              <tr>
                <td class="p-2.5 font-semibold">Campus Lecture</td>
                <td class="p-2.5">3.25h (Eve) / 6.5h (Sat)</td>
                <td class="p-2.5">45 mins round-trip</td>
                <td class="p-2.5">Eve dinner shifts to 16:30–17:30; leave 17:35</td>
              </tr>
              <tr>
                <td class="p-2.5 font-semibold">B2_Climbing (3x/wk)</td>
                <td class="p-2.5">3.0 – 4.0 hrs</td>
                <td class="p-2.5">1.5 hrs round-trip</td>
                <td class="p-2.5">4.5–5.5h total block; Wed, Fri, Sun/Mon</td>
              </tr>
              <tr>
                <td class="p-2.5 font-semibold">C3_Gym (1x/wk)</td>
                <td class="p-2.5">2.0 – 3.0 hrs</td>
                <td class="p-2.5">~40 mins round-trip</td>
                <td class="p-2.5">Randomized body-part; never on Climbing day</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    // State Management
    let currentLang = 'en';
    let currentDayId = 'tue-nov17';
    let schedulesState = {};

    // Master Data for Representative Scenarios
    const initialScenarios = {
      'tue-nov17': {

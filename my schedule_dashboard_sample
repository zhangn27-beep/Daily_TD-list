    // Render Day Selector Tabs
    function renderDayTabs() {
      const container = document.getElementById('day-selector-grid');
      container.innerHTML = '';

      Object.values(schedulesState).forEach(day => {
        const isActive = day.id === currentDayId;
        const btn = document.createElement('button');
        btn.onclick = () => {
          currentDayId = day.id;
          renderAll();
        };
        btn.className = isActive
          ? 'text-left p-3 rounded-xl border-2 border-indigo-600 bg-indigo-50/60 shadow-xs transition'
          : 'text-left p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition';

        btn.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold ${isActive ? 'text-indigo-900' : 'text-slate-800'}">
              ${currentLang === 'en' ? day.tabDateEn : day.tabDateZh}
            </span>
            ${isActive ? '<span class="w-2 h-2 rounded-full bg-indigo-600"></span>' : ''}
          </div>
          <div class="text-[11px] mt-0.5 ${isActive ? 'text-indigo-700 font-medium' : 'text-slate-500'}">
            ${currentLang === 'en' ? day.tabTagEn : day.tabTagZh}
          </div>
        `;
        container.appendChild(btn);
      });
    }


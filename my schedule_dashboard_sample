        skippedEn: 'C3_Gym (1x/wk), B1_Case Study (deferred to Thu/Sun)',
        skippedZh: 'C3_Gym（本周1次顺延）、B1_Case Study（移至周四/周日）',
        rebalanceLogs: [],
